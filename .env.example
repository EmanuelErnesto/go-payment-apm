# --- API ---
HTTP_PORT=8080
GIN_MODE=debug
SWAGGER_ENABLED=true
PAYMENT_SIMULATED_DELAY=3s
HTTP_WRITE_TIMEOUT=30s
LOG_LEVEL=info

# --- Database (the API connects with the least-privilege role) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payments
DB_USER=payments_app
DB_PASSWORD=change-me-app
DB_SSLMODE=disable

# Owner role: used only by the postgres init script and golang-migrate
POSTGRES_USER=payments_owner
POSTGRES_PASSWORD=change-me-owner

# --- Elastic stack ---
ELASTIC_VERSION=9.5.6
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=payments-api
ELASTIC_APM_ENVIRONMENT=local
ELASTIC_APM_SECRET_TOKEN=change-me-apm-token
# Must have at least 32 characters
KIBANA_ENCRYPTION_KEY=change-me-with-at-least-32-characters
